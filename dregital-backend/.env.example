# ── Server ────────────────────────────────────────────────
# Port the API listens on
PORT=4000
# development | production
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS). Credentials/cookies are enabled.
CLIENT_URL=http://localhost:5173

# ── Supabase ──────────────────────────────────────────────
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# SERVICE ROLE key — found in Supabase Dashboard → Project Settings → API.
# ⚠️ NEVER put this in the frontend. It lives only in this backend .env.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin credentials ─────────────────────────────────────
# These are the ONLY credentials that can log into the Admin Dashboard.
# They are read by the backend at runtime — never hardcoded in the frontend.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
# Secret used to sign admin session JWTs (use a long random string).
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret-string
# Session lifetime, e.g. 12h, 7d
ADMIN_JWT_EXPIRES_IN=12h
